{
  "name": "@rigapp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RigApp desktop app",
  "author": "doole",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @rigapp/web build && vite build -c vite.config.mts --mode server && vite build -c vite.config.mts --mode main && vite build -c vite.config.mts --mode preload",
    "start": "pnpm build && electron .",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
