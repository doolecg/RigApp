{
  "name": "rigapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @rigapp/server --filter @rigapp/web run dev",
    "build": "pnpm --filter @rigapp/web run build",
    "start": "pnpm --filter @rigapp/server run start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "test:e2e": "pnpm build && playwright test -c e2e",
    "desktop": "pnpm --filter @rigapp/desktop start",
    "dist:win": "pnpm --filter @rigapp/desktop dist:win"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
